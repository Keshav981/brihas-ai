# Copy to .env and fill in.

# --- Postgres (read-only access is all the app needs) ---
PGHOST=127.0.0.1
PGPORT=5434
PGUSER=founder@brihas.ai
PGPASSWORD=
PGDATABASE=brihasai
# set to "require" to use SSL
PGSSL=disable
# Safety limits
PG_STATEMENT_TIMEOUT_MS=20000
PG_POOL_MAX=4

# --- Claude ---
ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-opus-5
# AI_EFFORT=high            # low | medium | high | xhigh | max
# AI_FALLBACKS=on           # "off" disables server-side refusal fallbacks

# --- Server ---
PORT=8787
# DASHBOARDS_FILE=./data/dashboards.json
